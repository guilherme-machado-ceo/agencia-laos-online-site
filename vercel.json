{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "VITE_SUPABASE_URL": "@pozo_supabase_url",
    "VITE_SUPABASE_ANON_KEY": "@pozo_supabase_anon_key",
    "VITE_ANTHROPIC_KEY": "@pozo_anthropic_key"
  }
}
